{
  "name": "dsh-conversation-find",
  "version": "0.1.0",
  "type": "module",
  "description": "VS Code-style find bar for the DeepSeek Harness Web UI conversation window: search loaded messages, highlight matches, jump between them, and load earlier history from the bar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinvacn/dsh-conversation-find.git"
  },
  "homepage": "https://github.com/sinvacn/dsh-conversation-find#readme",
  "bugs": {
    "url": "https://github.com/sinvacn/dsh-conversation-find/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "conversation",
    "find-in-conversation",
    "search"
  ]
}
